{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "developerId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d9\u05d6\u05dd"
    },
    "invoiceNumber": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3 \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "overdue"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "\u05e4\u05d9\u05e8\u05d5\u05d8 \u05d4\u05d7\u05d9\u05d5\u05d1\u05d9\u05dd \u05d1\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    }
  },
  "required": [
    "developerId",
    "invoiceNumber",
    "amount",
    "dueDate",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}