{
  "name": "ChatSession",
  "type": "object",
  "properties": {
    "answers": {
      "type": "object",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "current_question": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e6'\u05d0\u05d8 \u05d4\u05d5\u05e9\u05dc\u05dd"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "living",
        "investment",
        "general"
      ],
      "default": "general",
      "description": "\u05de\u05d8\u05e8\u05ea \u05d4\u05d7\u05d9\u05e4\u05d5\u05e9"
    },
    "is_guided": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4 \u05de\u05e1\u05e2 \u05de\u05d5\u05d3\u05e8\u05da"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}