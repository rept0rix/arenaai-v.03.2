{
  "name": "InterestTrigger",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e9\u05df \u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "property_inquiry",
        "financing_request",
        "arena_club",
        "social_signin"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4-Trigger"
    },
    "property_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e0\u05db\u05e1 (\u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9)"
    },
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "consent_marketing": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05e1\u05db\u05de\u05d4 \u05dc\u05e9\u05d9\u05d5\u05d5\u05e7"
    },
    "consent_terms": {
      "type": "boolean",
      "description": "\u05d4\u05e1\u05db\u05de\u05d4 \u05dc\u05ea\u05e0\u05d0\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9"
    },
    "consent_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05e1\u05db\u05de\u05d4"
    },
    "consent_ip": {
      "type": "string",
      "description": "IP \u05e9\u05dc \u05d4\u05d4\u05e1\u05db\u05de\u05d4"
    },
    "additional_info": {
      "type": "object",
      "description": "\u05de\u05d9\u05d3\u05e2 \u05e0\u05d5\u05e1\u05e3 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d8\u05e8\u05d9\u05d2\u05e8"
    }
  },
  "required": [
    "session_id",
    "trigger_type",
    "full_name",
    "phone",
    "email",
    "consent_terms"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  }
}