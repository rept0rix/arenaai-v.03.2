{
  "name": "AnonymousSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e9\u05df \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9"
    },
    "device_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05db\u05e9\u05d9\u05e8"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "living",
        "investment",
        "general"
      ],
      "description": "\u05de\u05d8\u05e8\u05ea \u05d4\u05d7\u05d9\u05e4\u05d5\u05e9"
    },
    "profile_vector": {
      "type": "object",
      "description": "\u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05e2\u05d3\u05e4\u05d5\u05ea \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9\u05d9\u05dd - \u05dc\u05dc\u05d0 PII"
    },
    "conversation_context": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u05d4\u05e7\u05e9\u05e8 \u05e9\u05d9\u05d7\u05d4"
    },
    "triggers_activated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Triggers \u05e9\u05d4\u05d5\u05e4\u05e2\u05dc\u05d5"
    },
    "is_converted": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d5\u05de\u05e8 \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05e8\u05e9\u05d5\u05dd"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "session_id",
    "device_id"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}