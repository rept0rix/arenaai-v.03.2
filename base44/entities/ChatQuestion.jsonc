{
  "name": "ChatQuestion",
  "type": "object",
  "properties": {
    "question_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "open",
        "single_choice",
        "multiple_choice",
        "range"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05dc\u05d1\u05d7\u05d9\u05e8\u05d4 (\u05dc\u05e9\u05d0\u05dc\u05d5\u05ea \u05e1\u05d2\u05d5\u05e8\u05d5\u05ea)"
    },
    "order": {
      "type": "number",
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "filter_field": {
      "type": "string",
      "description": "\u05e9\u05d3\u05d4 \u05d1\u05e0\u05db\u05e1 \u05e9\u05d4\u05e9\u05d0\u05dc\u05d4 \u05de\u05e1\u05e0\u05e0\u05ea \u05dc\u05e4\u05d9\u05d5"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e9\u05d0\u05dc\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    }
  },
  "required": [
    "question_text",
    "question_type",
    "order"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}